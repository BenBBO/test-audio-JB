#!/usr/sbin/nft -f
# /etc/nftables.d/satellite.nft  (Raspberry Pi)
# Wyoming n'a ni authentification ni chiffrement : quiconque se connecte au port
# 10700 entend le micro. Seul le container du pont y a droit.
# Remplacer 192.168.1.20 par l'IP du container LXC.

table inet voice_satellite {
  chain input {
    type filter hook input priority 0; policy accept;
    tcp dport 10700 ip saddr != 192.168.1.20 drop
    tcp dport 10700 ip6 saddr ::/0 drop
  }
}
