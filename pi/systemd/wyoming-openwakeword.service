# /etc/systemd/system/wyoming-openwakeword.service  (Raspberry Pi, mode B uniquement)

[Unit]
Description=Wyoming openWakeWord (local)

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/wyoming-openwakeword
# Modèles personnalisés (.tflite) dans custom/ : le nom du fichier sans extension
# devient le nom du wake word (--wake-word-name côté satellite).
ExecStart=/home/pi/wyoming-openwakeword/script/run \
  --uri 'tcp://127.0.0.1:10400' \
  --custom-model-dir /home/pi/wyoming-openwakeword/custom \
  --threshold 0.5 \
  --trigger-level 1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
